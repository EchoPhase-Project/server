<Project>
    <PropertyGroup>
        <!-- xunit.v3 on Microsoft.Testing.Platform (not its own runner), so
             that MTP extensions such as code coverage load. Unconditional:
             IsTestProject is set later, in the project file. -->
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <!-- As in src: nullable warnings fail the build. -->
        <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup Condition="'$(IsTestProject)' == 'true'">
        <!-- Coverage for mise run test:coverage (Microsoft.Testing.Platform; coverlet.collector is VSTest only) -->
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.v3.runner.console" />
        <Using Include="Xunit" />
    </ItemGroup>
</Project>
