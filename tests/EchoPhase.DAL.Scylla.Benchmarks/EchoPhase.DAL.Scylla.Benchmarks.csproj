<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the Scylla ORM itself costs per query and save (translation,
       materialization, tracking, CQL generation), on canned rows:
       `mise run bench:scylla`. Not a test project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EchoPhase.DAL.Scylla\EchoPhase.DAL.Scylla.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

</Project>
