<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Packages built from source (see src/packages/README.md). -->
    <add key="local" value="src/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Isopoh.Cryptography.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
