# Visual Studio temporary files
.vs/

# ReSharper folders
_ReSharper*

# NuGet package directory
packages/

# MSTest test.Result
[Tt]est[Rr]esult*

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# Windows image file caches
Thumbs.db
ehthumbs.db

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Mono-specific files
*.pidb
*.idea/workspace.xml
.idea/

# Visual Studio Code directories
.vscode/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# JetBrains Rider
.idea/

# Rider files
.idea

# Files for debugging
*.pdb

# VS Code
.vscode/

# Ignore build output and logs
# Build outputs at any depth (plain bin/ only matches the context root):
# local builds and the CI openapi step write them next to the sources.
**/bin/
**/obj/
dist/
*.log

# Ignore NuGet packages
*.nupkg
packages/
*.lock.json

# Ignore Rider specific files
*.sln.iml

# Ignore node_modules directory if using npm for webapp packages
node_modules/

# Ignore backup and session files for vim
*.tmp
*.vim

Logs/
*.log

*.env
*.crt
*.key

# Local NuGet source (see packages/README.md): must reach the build. Keep last,
# after the packages/ and *.nupkg rules above.
!packages/
!packages/*.nupkg
!packages/README.md
