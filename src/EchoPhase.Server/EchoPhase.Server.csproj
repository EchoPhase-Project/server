<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<GenerateGlobalUsings>true</GenerateGlobalUsings>
    <GenerateDocumentationFile Condition="'$(Configuration)' == 'Debug'">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!--
      Password hashing is CPU-bound and synchronous (IPasswordHasher), so it holds
      a pool thread for ~0.6 s. The pool's minimum is the core count (2 in the pod):
      two hashes left no thread for other requests' async work until the pool slowly
      grew. PasswordHashingGate caps hashes at the core count; extra threads only
      keep everything else moving, not more CPU.
    -->
    <ThreadPoolMinThreads>32</ThreadPoolMinThreads>
  </PropertyGroup>

