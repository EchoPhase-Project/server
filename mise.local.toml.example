# Copy to mise.local.toml (gitignored) and fill in. mise loads it after
# mise.toml, in this directory only.
[env]
# Woodpecker as served in the tailnet (`tailscale status` shows the node name).
# Any port but 443, which k3s gives to Traefik on every node address.
WOODPECKER_SERVER = "https://<node>.<tailnet>.ts.net:9443"
# GitHub > Settings > Developer settings > OAuth Apps, callback <WOODPECKER_SERVER>/authorize
WOODPECKER_GITHUB_CLIENT = ""
WOODPECKER_GITHUB_SECRET = ""
# Woodpecker UI > user settings > access token (for `mise run ci:run`)
WOODPECKER_TOKEN = ""
